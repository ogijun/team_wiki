# Copy to .env and fill in real values (.env is gitignored).
# Loaded automatically in development/test via dotenv-rails — required when
# running under puma-dev, which does not inherit your shell's exported env.

# Discord OAuth (https://discord.com/developers/applications → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Access gate: only members of this guild holding this role can log in.
# Enable Discord Developer Mode, right-click the server / role → Copy ID.
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_ID=
