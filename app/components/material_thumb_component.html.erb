<% if @material.thumbnailable_file? %><%= image_tag @material.thumbnail(48), class: "material-thumb", loading: "lazy", alt: @material.display_title %><% elsif (src = @material.preview_image_url) %><%= image_tag src, class: "material-thumb", loading: "lazy", alt: @material.display_title %><% else %><span class="material-thumb material-thumb--icon" title="<%= @material.display_title %>"><%= helpers.media_icon(@material) %></span><% end %>
