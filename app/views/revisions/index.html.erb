<h1>履歴: <%= @article.title %></h1>
<ul>
  <% @revisions.each do |rev| %>
    <li>
      <%= link_to "##{rev.id} #{rev.created_at.to_fs(:jp)}", article_revision_path(@article, rev) %>
      by <%= display_name(rev.author) %> <%= rev.edit_summary %>
      <% if (prev = @previous_of[rev.id]) %>
        <%= link_to "前の版との差分", article_revision_path(@article, rev, a: prev.id) %>
      <% end %>
      <%= button_to "この版に復元", restore_article_revision_path(@article, rev), class: "secondary outline btn-sm", data: { turbo_confirm: "復元しますか?" } %>
    </li>
  <% end %>
</ul>
