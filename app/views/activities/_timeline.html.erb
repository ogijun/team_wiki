<ul class="timeline">
  <% activities.each do |a| %>
    <li>
      <strong><%= link_to display_name(a.user), a.user %></strong><%= activity_phrase(a) %>
      <% if a.subject && a.subject_label.present? %>
        （<%= link_to a.subject_label, a.subject %>）
      <% end %>
      <span class="muted"><%= local_time_ago(a.created_at) %></span>
    </li>
  <% end %>
</ul>
