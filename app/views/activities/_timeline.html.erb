<ul class="timeline">
  <% groups.each do |group| %>
    <% rep = group.activities.first %>
    <li>
      <%= activity_group_icon(group) %>
      <% show_actor = local_assigns.fetch(:show_actor, true) %>
      <% if show_actor %><strong><%= link_to display_name(rep.user), rep.user %></strong><% end %><%= activity_group_phrase(group, actor: show_actor) %>
      <span class="muted"><%= local_time_ago(rep.created_at) %></span>
    </li>
  <% end %>
</ul>
