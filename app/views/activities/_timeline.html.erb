<ul class="timeline">
  <% groups.each do |item| %>
    <% if item.respond_to?(:activities) %>
      <% rep = item.activities.first %>
      <li>
        <%= activity_group_icon(item) %>
        <% show_actor = local_assigns.fetch(:show_actor, true) %>
        <% if show_actor %><strong><%= link_to display_name(rep.user), rep.user %></strong><% end %><%= activity_group_phrase(item, actor: show_actor) %>
        <span class="muted"><%= local_time_ago(rep.created_at) %></span>
      </li>
    <% else %>
      <li class="timeline__overflow muted">
        <%= link_to display_name(item.user), item.user %> の活動 ほか<%= item.count %>件
      </li>
    <% end %>
  <% end %>
</ul>
