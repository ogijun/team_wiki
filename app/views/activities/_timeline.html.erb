<ul class="timeline">
  <% activities.each do |a| %>
    <li>
      <%= activity_icon(a) %>
      <% show_actor = local_assigns.fetch(:show_actor, true) %>
      <% if show_actor %><strong><%= link_to display_name(a.user), a.user %></strong><% end %><%= activity_phrase(a, actor: show_actor) %>
      <span class="muted"><%= local_time_ago(a.created_at) %></span>
    </li>
  <% end %>
</ul>
