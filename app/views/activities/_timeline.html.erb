<ul class="timeline">
  <% activities.each do |a| %>
    <li>
      <strong><%= a.user.name %></strong><%= activity_phrase(a) %>
      <% if a.subject && a.subject_label.present? %>
        （<%= link_to a.subject_label, a.subject %>）
      <% end %>
      <span class="muted"><%= a.created_at.to_fs(:short) %></span>
    </li>
  <% end %>
</ul>
