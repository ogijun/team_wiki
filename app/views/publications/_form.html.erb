<%= form_with model: publication, class: "stacked-form" do |f| %>
  <%= render "shared/error_messages", record: publication %>

  <div class="field">
    <%= f.label :title, "商品名" %><%= required_badge %>
    <small class="field__hint">版が分かる名前を（例「○○○ 文庫版」「○○○ Blu-ray BOX」）。</small>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :cover, "書影" %><%= optional_badge %>
    <small class="field__hint">表紙・ジャケット写真（PNG/JPEG/GIF/WebP）。詳細ページの主役になります。</small>
    <%# 既に書影がある場合はプレビューを出す（「入っていること」が見えないと、うっかり差し替え・見落としが起きる）。 %>
    <% if publication.cover.attached? %>
      <span class="field__preview">
        <%= image_tag publication.cover_thumbnail(96), class: "material-thumb", loading: "lazy", alt: "現在の書影" %>
        <small class="muted">選び直すと差し替わります。</small>
      </span>
    <% end %>
    <%= f.file_field :cover, accept: Publication::COVER_CONTENT_TYPES.join(",") %>
  </div>

  <div class="field">
    <%= f.label :kind, "種別" %><%= required_badge %>
    <%= f.select :kind, Publication::KINDS.map { |value, label| [ label, value ] } %>
  </div>

  <%= render "shared/fuzzy_date_fields", f: f, accessor: :released, fuzzy: publication.released, label: "発売日", hint: "わかる粒度だけでOK（年だけ・年月だけでも可）。年表にも使われます。" %>

  <div class="field">
    <%= f.label :sales_status, "販売状況" %><%= required_badge %>
    <%= f.select :sales_status, Publication::SALES_STATUSES.map { |value, label| [ label, value ] } %>
  </div>

  <div class="field">
    <%= f.label :store_url, "販売ページの URL" %><%= optional_badge %>
    <small class="field__hint">販売中のときだけ「購入する」ボタンが出ます。</small>
    <%= f.url_field :store_url %>
  </div>

  <%= f.submit publication.persisted? ? "保存する" : "登録する" %>
<% end %>
