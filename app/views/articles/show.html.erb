<article>
  <%= link_to "← 記事一覧", articles_path, class: "back-link" %>
  <h1><%= @article.title %></h1>
  <p class="badges">
    <%= render BadgeComponent.new(text: @article.status_label, variant: :status) %>
    <% if @article.kind %><%= render BadgeComponent.new(text: @article.kind_label, variant: :kind) %><% end %>
  </p>
  <%= render FuzzyDateComponent.new(starts: @article.starts, ends: @article.ends, icon: true) %>
  <% contributors = @article.contributors %>
  <% if contributors.any? %>
    <section class="contributors">
      <% contributors.each do |u| %>
        <%= link_to avatar_tag(u, size: 24), u, title: display_name(u) %>
      <% end %>
    </section>
  <% end %>
  <div class="actions">
    <%= link_to "編集", edit_article_path(@article), role: "button", class: "btn-sm" %>
    <%= link_to "履歴", article_revisions_path(@article) %>
    <%= button_to "削除", @article, method: :delete, class: "secondary outline btn-sm", data: { turbo_confirm: "削除しますか?" } %>
  </div>
  <% tags = @article.tags.to_a %>
  <% if tags.any? %>
    <p>タグ: <% tags.each do |t| %><%= link_to "##{t.name}", tag_path(t) %> <% end %></p>
  <% end %>
  <div class="page-body">
    <%= @rendered.html %>
  </div>
  <% if @rendered.references.any? %>
    <section class="citations">
      <h2>出典</h2>
      <ol>
        <% @rendered.references.each do |ref| %>
          <li id="ref-<%= ref.number %>"><%= render CitationComponent.new(material: ref.material) %></li>
        <% end %>
      </ol>
    </section>
  <% end %>
  <% backlinks = @backlinks.to_a %>
  <% if backlinks.any? %>
    <section class="backlinks">
      <h2>バックリンク</h2>
      <ul>
        <% backlinks.each do |link| %>
          <li><%= link_to link.source_article.title, link.source_article %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <% materials = @article.materials.order(created_at: :desc).to_a %>
  <% if materials.any? %>
    <section class="materials">
      <h2>資料</h2>
      <ul>
        <% materials.each do |m| %>
          <li><%= media_icon(m) %> <%= link_to m.display_title, material_path(m) %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</article>
