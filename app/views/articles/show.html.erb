<article>
  <%= link_to "← 記事一覧", articles_path, class: "back-link" %>
  <h1><%= @article.title %></h1>
  <p class="page-meta">
    <%= render BadgeComponent.new(text: @article.status_label, variant: :status) %>
    <% if @article.kind %><%= render BadgeComponent.new(text: @article.kind_label, variant: :kind) %><% end %>
    <%= render FuzzyDateComponent.new(starts: @article.starts, ends: @article.ends, icon: true) %>
    <% tags = @article.tags.to_a %>
    <% if tags.any? %>
      <span><% tags.each do |t| %><%= link_to "##{t.name}", tag_path(t) %> <% end %></span>
    <% end %>
    <% contributors = @article.contributors %>
    <% if contributors.any? %>
      <span class="contributors"><% contributors.each do |u| %><%= avatar_link(u, size: 20) %><% end %></span>
    <% end %>
  </p>
  <div class="actions">
    <%= link_to "本文を編集", edit_article_path(@article), role: "button", class: "btn-sm secondary outline" %>
    <%= link_to "履歴", article_revisions_path(@article), role: "button", class: "btn-sm secondary outline" %>
  </div>
  <div class="page-body">
    <%= @rendered.html %>
  </div>
  <% if @rendered.references.any? %>
    <section class="citations">
      <h2>出典</h2>
      <ol>
        <% @rendered.references.each do |ref| %>
          <li id="ref-<%= ref.number %>"><%= render CitationComponent.new(material: ref.material) %></li>
        <% end %>
      </ol>
    </section>
  <% end %>
  <% backlinks = @backlinks.to_a %>
  <% if backlinks.any? %>
    <section class="backlinks">
      <h2>バックリンク</h2>
      <ul>
        <% backlinks.each do |link| %>
          <li><%= link_to link.source_article.title, link.source_article %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <%= render "comments/comments", commentable: @article %>

  <div class="danger-zone">
    <span class="danger-zone__label">危険な操作</span>
    <%= button_to "削除", @article, method: :delete, class: "btn-sm btn-danger", data: { turbo_confirm: "削除しますか?" } %>
  </div>
</article>
