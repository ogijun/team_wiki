<div class="page-header">
  <h1>記事一覧</h1>
  <%= link_to "新規作成", new_article_path, role: "button" %>
</div>
<p class="filters">
  種別:
  <%= link_to "すべて", articles_path %>
  <% Article::KINDS.each do |slug, label| %>| <%= link_to label, articles_path(kind: slug, status: params[:status]) %><% end %>
  ／ 状態:
  <% Article::STATUSES.each do |slug, label| %><%= link_to label, articles_path(status: slug, kind: params[:kind]) %> <% end %>
</p>
<ul>
  <% @articles.each do |article| %>
    <li>
      <%= link_to article.title, article %>
      <small><%= article.status_label %><% if article.kind %>・<%= article.kind_label %><% end %> / <%= article.updated_at.to_date.to_fs(:jp) %></small>
    </li>
  <% end %>
</ul>

<section class="recent-activity">
  <h2>最近の動き</h2>
  <%= render "activities/timeline", activities: @recent_activities %>
  <p><%= link_to "すべて見る", activities_path %></p>
</section>
