<%= form_with model: article, url: form_url, class: "stacked-form", data: { controller: "editor", action: "submit->editor#writeBack" } do |f| %>
  <%= render "shared/error_messages", record: article %>
  <%# 楽観ロック: 編集画面を開いた時点の版。同時編集の後勝ち上書きを防ぐ。 %>
  <%= f.hidden_field :lock_version if article.persisted? %>

  <fieldset data-controller="chronicle-date">
    <legend>日時（年表に表示）<%= optional_badge %></legend>
    <%= render "shared/fuzzy_date_fields", f: f, attribute: :starts, value: article.starts, label: "開始", hint: "1979・1979/4・1979/4/7 14:30 のように入力。空なら不明。" %>

    <a href="#" data-chronicle-date-target="endLink" data-action="chronicle-date#addEnd">期間を指定</a>

    <div data-chronicle-date-target="end" hidden>
      <%= render "shared/fuzzy_date_fields", f: f, attribute: :ends, value: article.ends, label: "終了", hint: "期間の終わり。開始以降を入力してください。" %>
      <button type="button" class="date-clear" data-action="chronicle-date#removeEnd" aria-label="終了を消す" title="終了を消す">×</button>
    </div>
  </fieldset>

  <div class="field">
    <%= f.label :kind, "種別" %><%= optional_badge %>
    <%= f.select :kind, Article::KINDS.map { |slug, label| [label, slug] }, { include_blank: "未分類" } %>
  </div>
  <div class="field">
    <%= f.label :status, "状態" %><%= optional_badge %>
    <small class="field__hint">スタブ＝書きかけでもOK。完成にしなくて大丈夫、あとから育てられます。</small>
    <%= f.select :status, Article::STATUSES.map { |slug, label| [label, slug] }, { selected: article.status || "stub" } %>
  </div>
  <div class="field"><%= f.label :title, "タイトル" %><%= required_badge %><%= f.text_field :title %></div>
  <div class="field">
    <%= f.label :body, "本文(Markdown)" %><%= required_badge %>
    <small class="field__hint">他の記事へは <code>[[記事名]]</code> でリンクできます（赤いリンクは未作成＝作ればOK）。資料を出典として引用するときは、ツールバーの「引用」ボタンから挿入します。</small>
    <%= f.text_area :body, value: body_value, data: { editor_target: "source" } %>
  </div>
  <div class="field"><%= f.label :tag_names, "タグ(カンマ区切り)" %><%= optional_badge %><%= f.text_field :tag_names, value: tag_names_value %></div>
  <div class="field">
    <%= f.label :edit_summary, "編集メモ" %><%= optional_badge %>
    <small class="field__hint">何を変えたか一言（任意・空でもOK）。履歴に残るので、後から経緯を追いやすくなります。</small>
    <%= f.text_area :edit_summary, rows: 2 %>
  </div>

  <% if article.new_record? %>
    <div class="field">
      <%= label_tag :first_comment, "最初のコメント" %><%= optional_badge %>
      <small class="field__hint">最初のコメントとして残ります（任意）。メモや方針など。あとから詳細画面で追記できます。</small>
      <%= text_area_tag :first_comment, nil, rows: 2 %>
    </div>
  <% end %>

  <%= f.submit %>
<% end %>
