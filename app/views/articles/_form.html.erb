<%= form_with model: article, url: form_url, data: { controller: "editor", action: "submit->editor#writeBack" } do |f| %>
  <% if article.errors.any? %>
    <ul><% article.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>

  <fieldset data-controller="chronicle-date">
    <legend>日時（任意・年表に表示）</legend>

    <div class="date-row">
      <span data-chronicle-date-target="startLabel" hidden>開始:</span>
      <%= f.number_field :start_year, value: fuzzy_part(article.starts, :year), placeholder: "年" %>
      <%= f.number_field :start_month, in: 1..12, value: fuzzy_part(article.starts, :month), placeholder: "月" %>
      <%= f.number_field :start_day, in: 1..31, value: fuzzy_part(article.starts, :day), placeholder: "日" %>
      <span data-chronicle-date-target="startTime" hidden>
        <%= f.number_field :start_hour, in: 0..23, value: fuzzy_part(article.starts, :hour), placeholder: "時", data: { chronicle_date_target: "startHour" } %>:<%= f.number_field :start_minute, in: 0..59, value: fuzzy_part(article.starts, :minute), placeholder: "分" %>
      </span>
      <a href="#" data-chronicle-date-target="startTimeLink" data-action="chronicle-date#addStartTime">時間を追加</a>
    </div>

    <a href="#" data-chronicle-date-target="endLink" data-action="chronicle-date#addEnd">期間を指定</a>

    <div class="date-row" data-chronicle-date-target="end" hidden>
      終了:
      <%= f.number_field :end_year, value: fuzzy_part(article.ends, :year), placeholder: "年", data: { chronicle_date_target: "endYear" } %>
      <%= f.number_field :end_month, in: 1..12, value: fuzzy_part(article.ends, :month), placeholder: "月" %>
      <%= f.number_field :end_day, in: 1..31, value: fuzzy_part(article.ends, :day), placeholder: "日" %>
      <span data-chronicle-date-target="endTime" hidden>
        <%= f.number_field :end_hour, in: 0..23, value: fuzzy_part(article.ends, :hour), placeholder: "時", data: { chronicle_date_target: "endHour" } %>:<%= f.number_field :end_minute, in: 0..59, value: fuzzy_part(article.ends, :minute), placeholder: "分" %>
      </span>
      <a href="#" data-chronicle-date-target="endTimeLink" data-action="chronicle-date#addEndTime">時間を追加</a>
      <button type="button" class="date-clear" data-action="chronicle-date#removeEnd" aria-label="終了を消す" title="終了を消す">×</button>
    </div>
  </fieldset>

  <div>
    <%= f.label :kind, "種別" %>
    <%= f.select :kind, Article::KINDS.map { |slug, label| [label, slug] }, { include_blank: "未分類" } %>
  </div>
  <div>
    <%= f.label :status, "状態" %>
    <%= f.select :status, Article::STATUSES.map { |slug, label| [label, slug] }, { selected: article.status || "stub" } %>
  </div>
  <div><%= f.label :title, "タイトル" %><%= f.text_field :title %></div>
  <div>
    <%= f.label :body, "本文(Markdown)" %>
    <%= f.text_area :body, value: body_value, data: { editor_target: "source" } %>
  </div>
  <div><%= f.label :tag_names, "タグ(カンマ区切り)" %><%= f.text_field :tag_names, value: tag_names_value %></div>
  <div><%= f.label :edit_summary, "編集メモ" %><%= f.text_area :edit_summary, rows: 2 %></div>

  <%= f.submit %>
<% end %>
