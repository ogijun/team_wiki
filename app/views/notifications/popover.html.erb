<%= turbo_frame_tag "notifications_popover", target: "_top" do %>
  <div class="topbar__menu topbar__notifications-menu">
    <strong class="topbar__notifications-heading">お知らせ</strong>
    <% if @notifications.any? %>
      <ul class="timeline">
        <% @notifications.each do |notification| %>
          <li>
            <%= avatar_tag(notification.actor, size: 24) %>
            <span class="timeline__body"><%= notification_message(notification) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">お知らせはありません。</p>
    <% end %>
    <% if @has_more %>
      <%= link_to "もっと見る", notifications_path %>
    <% end %>
  </div>
<% end %>
