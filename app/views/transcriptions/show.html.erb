<% content_for :title, "文字起こし — #{@material.title}" %>

<%= link_to "← #{@material.title}", @material, class: "back-link" %>
<h1>文字起こし</h1>
<p class="page-meta">
  <%= render BadgeComponent.new(text: @transcription.status_label, variant: :status) %>
  <% if @transcription.creation_summary %><span>作成: <%= @transcription.creation_summary %></span><% end %>
  <span>by <%= link_to display_name(@transcription.author), @transcription.author %> ・ <%= @transcription.updated_at.to_fs(:jp) %></span>
</p>
<div class="actions">
  <%= link_to "文字起こしを編集", edit_material_transcription_path(@material), role: "button", class: "btn-sm secondary outline" %>
</div>

<div class="prewrap"><%= @transcription.body %></div>
