<h1>アカウント設定</h1>

<%= form_with model: @user, url: account_path, method: :patch, class: "stacked-form" do |f| %>
  <%= render "shared/error_messages", record: @user %>

  <div class="field">
    <%= f.label :avatar, "アイコン画像" %><%= optional_badge %>
    <div class="media-preview"><%= avatar_tag(@user, size: 64) %></div>
    <%= f.file_field :avatar, accept: "image/*" %>
  </div>
  <div class="field">
    <%= f.label :name, "表示名" %><%= optional_badge %>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :email_address, "メール" %><%= required_badge %>
    <%= f.email_field :email_address %>
  </div>

  <%= f.submit "更新" %>
<% end %>

<p><%= link_to "公開プロフィールを見る", user_path(@user) %></p>
