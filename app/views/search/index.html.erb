<h1>検索</h1>
<%= form_with url: search_path, method: :get do |f| %>
  <%= f.search_field :q, value: @q, placeholder: "検索…" %>
<% end %>

<% if @q.present? %>
  <div class="muted search-note">いまはまだ全文検索が有効になっていないため、検索精度はよくありません。</div>

  <% if @results.any? %>
    <ul class="search-results">
      <% @results.each do |r| %>
        <li>
          <% if r.is_a?(Article) %>
            <%= icon("newspaper") %> <%= link_to search_mark(r.title, @q), r %>
            <% if (snippet = search_snippet(r.current_revision&.body, @q)) %>
              <div class="search-snippet muted"><%= snippet %></div>
            <% end %>
          <% else %>
            <%= media_icon(r) %> <%= link_to search_mark(r.title, @q), r %>
            <% body = r.transcriptions.find { |t| t.body&.include?(@q) }&.body || r.transcriptions.first&.body %>
            <% if (snippet = search_snippet(body, @q)) %>
              <div class="search-snippet muted">文字起こし: <%= snippet %></div>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="empty-state">
      「<%= @q %>」に一致する記事・資料は見つかりませんでした。別の言葉や、名前の一部でもお試しください。（全文検索は今後対応予定です）
    </div>
  <% end %>
<% end %>
