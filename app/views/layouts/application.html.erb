<!DOCTYPE html>
<html lang="ja" data-theme="light">
  <head>
    <title><%= content_for(:title) || brand_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= brand_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <% if (favicon = site_icon_url(32)) %>
      <link rel="icon" type="image/png" sizes="32x32" href="<%= favicon %>">
      <link rel="apple-touch-icon" sizes="180x180" href="<%= site_icon_url(180) %>">
    <% else %>
      <link rel="icon" href="/icon.png" type="image/png">
      <link rel="icon" href="/icon.svg" type="image/svg+xml">
      <link rel="apple-touch-icon" href="/icon.png">
    <% end %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.classless.min.css">
    <%# 自前CSSは役割別の3層。読み込み順が規約: tokens(変数) → base(骨格/Pico上書き) → components(部品語彙) %>
    <%= stylesheet_link_tag "tokens", "base", "components", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
    <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="sidebar">
    <header class="topbar">
      <button type="button" class="topbar__toggle" data-action="sidebar#toggle" aria-label="メニューを開閉"><%= icon("menu") %></button>
      <span class="brand"><%= link_to brand_display, root_path %></span>
      <%# 検索: アイコンだけ出し、押すとトップバーを覆うオーバーレイで検索窓を出す（全画面共通）。 %>
      <div class="topbar__search" data-controller="search">
        <button type="button" class="topbar__search-toggle" data-action="search#open"
                data-search-target="toggle" aria-label="検索を開く" aria-expanded="false"
                aria-controls="search-overlay"><%= icon("search") %></button>
        <div class="topbar__search-overlay" id="search-overlay" data-search-target="overlay" hidden>
          <form action="<%= search_path %>" method="get" role="search">
            <%# 虫めがねは Pico が input[type=search] に付ける native 装飾を使う（自前アイコンは置かない）。 %>
            <input type="search" name="q" placeholder="検索…" aria-label="検索" data-search-target="input">
          </form>
          <button type="button" class="topbar__search-close" data-action="search#close"
                  data-search-target="close" aria-label="検索を閉じる">×</button>
        </div>
      </div>
      <% if Current.user %>
        <details class="topbar__notifications" data-controller="menu notification-popover" data-action="toggle->notification-popover#markRead">
          <summary aria-label="お知らせを開く">
            <%= icon("bell") %>
            <% if (count = Current.user.unread_notifications_count).positive? %>
              <span class="badge" data-notification-popover-target="badge"><%= count %></span>
            <% end %>
          </summary>
          <%= turbo_frame_tag "notifications_popover", src: notifications_path, loading: :lazy, target: "_top" %>
        </details>
        <details class="topbar__user-menu" data-controller="menu">
          <summary aria-label="ユーザーメニューを開く">
            <%= avatar_tag(Current.user, size: 32) %>
          </summary>
          <div class="topbar__menu">
            <%= link_to Current.user do %><%= icon("user") %> <strong><%= display_name(Current.user) %></strong><% end %>
            <%= link_to edit_account_path do %><%= icon("settings") %> 設定<% end %>
            <%= button_to session_path, method: :delete, class: "topbar__logout" do %><%= icon("log-out") %> ログアウト<% end %>
          </div>
        </details>
      <% end %>
    </header>

    <aside class="sidebar">
      <nav class="sidebar__nav" data-action="click->sidebar#close">
        <%= link_to root_path do %><%= icon("house") %> ホーム<% end %>
        <div class="nav-group">
          <span class="nav-group__label">コンテンツ</span>
          <%= link_to materials_path do %><%= icon("landmark") %> 資料<% end %>
          <%= link_to transcriptions_path do %><%= icon("audio-lines") %> 文字起こし<% end %>
          <%= link_to tags_path do %><%= icon("tags") %> タグ<% end %>
          <%= link_to chronicle_path do %><%= icon("calendar-days") %> 年表 <small class="wip">(検討中)</small><% end %>
          <%= link_to members_path do %><%= icon("users") %> メンバー<% end %>
          <hr class="nav-sep">
          <%= link_to articles_path do %><%= icon("newspaper") %> 記事 <small class="wip">(見直し中)</small><% end %>
        </div>
        <% if Current.user&.admin? %>
          <div class="nav-group">
            <span class="nav-group__label">管理</span>
            <%= link_to edit_settings_path do %><%= icon("settings") %> 設定<% end %>
          </div>
        <% end %>
        <%= link_to about_path, class: "sidebar__about" do %><%= icon("info") %> このサイトについて<% end %>
      </nav>
    </aside>

    <div class="backdrop" data-action="click->sidebar#close"></div>

    <%# 右サイドバー: 用途未定の足場。各ページが content_for :aside で中身を入れたときだけ出す
        （空の landmark を出さない）。表示は十分広い画面のみ（base.css の .sidebar-right）。 %>
    <% if content_for?(:aside) %>
      <aside class="sidebar-right"><%= yield :aside %></aside>
    <% end %>

    <%# flash はトースト化（右下に積み上げ）。notice は自動消去、alert は手動（× で閉じる）。
        クラス .flash/.flash--type は維持（既存アサーション互換）。 %>
    <% if flash.any? %>
      <div class="toast-stack" data-controller="toast">
        <% flash.each do |type, message| %>
          <div class="flash flash--<%= type %>" data-toast-target="toast" data-auto="<%= type.to_s == "notice" %>">
            <span class="flash__msg"><%= message %></span>
            <button type="button" class="flash__close" data-action="toast#dismiss" aria-label="閉じる">×</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main>
      <%= yield %>
      <% if (footer = render_site_markdown(site_setting.footer)) %>
        <footer class="site-footer"><%= footer.html %></footer>
      <% end %>
    </main>
  </body>
</html>
