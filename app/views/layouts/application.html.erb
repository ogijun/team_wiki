<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Team Wiki" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Team Wiki">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.classless.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
    <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
    <nav>
      <ul>
        <li><%= link_to "ホーム", root_path %></li>
        <li><%= link_to "新規", new_article_path %></li>
        <li><%= link_to "タグ", tags_path %></li>
        <li><%= link_to "資料", materials_path %></li>
        <li><%= link_to "アクティビティ", activities_path %></li>
        <li><%= link_to "年表", chronicle_path %></li>
        <li><%= link_to "検索", search_path %></li>
      </ul>
      <% if Current.user %>
        <ul>
          <li>
            <%= link_to edit_account_path, class: "user" do %>
              <%= avatar_tag(Current.user, size: 24) %> <%= display_name(Current.user) %>
            <% end %>
          </li>
          <li><span class="btn-muted"><%= button_to "ログアウト", session_path, method: :delete %></span></li>
        </ul>
      <% end %>
    </nav>
    </header>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
