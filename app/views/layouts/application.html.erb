<!DOCTYPE html>
<html lang="ja" data-theme="light">
  <head>
    <title><%= content_for(:title) || brand_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= brand_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.classless.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
    <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="sidebar">
    <header class="topbar">
      <button type="button" class="topbar__toggle" data-action="sidebar#toggle" aria-label="メニューを開閉">☰</button>
      <strong class="brand"><%= link_to brand_display, root_path %></strong>
    </header>

    <aside class="sidebar">
      <strong class="brand sidebar__brand"><%= link_to brand_display, root_path %></strong>

      <form class="sidebar__search" action="<%= search_path %>" method="get" role="search">
        <input type="search" name="q" placeholder="検索…" aria-label="検索">
      </form>

      <nav class="sidebar__nav" data-action="click->sidebar#close">
        <%= link_to "ホーム", root_path %>
        <div class="nav-group">
          <span class="nav-group__label">コンテンツ</span>
          <%= link_to "記事一覧", articles_path %>
          <%= link_to chronicle_path do %>年表 <small class="wip">(検討中)</small><% end %>
          <%= link_to "タグ", tags_path %>
          <%= link_to "資料", materials_path %>
        </div>
        <% if Current.user&.admin? %>
          <div class="nav-group">
            <span class="nav-group__label">管理</span>
            <%= link_to "メンバー", users_path %>
            <%= link_to "設定", edit_settings_path %>
          </div>
        <% end %>
      </nav>
      <% if Current.user %>
        <div class="sidebar__user">
          <%= link_to edit_account_path, class: "user-link" do %>
            <%= avatar_tag(Current.user, size: 24) %> <%= display_name(Current.user) %>
          <% end %>
          <%= button_to "ログアウト", session_path, method: :delete, class: "secondary outline btn-sm" %>
        </div>
      <% end %>
    </aside>

    <div class="backdrop" data-action="click->sidebar#close"></div>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
