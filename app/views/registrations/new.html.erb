<h1>サインアップ</h1>
<%= form_with model: @user, url: registration_path do |f| %>
  <% if @user.errors.any? %>
    <ul><% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
  <% end %>
  <div><%= f.label :name, "表示名" %><%= f.text_field :name %></div>
  <div><%= f.label :email_address, "メール" %><%= f.email_field :email_address %></div>
  <div><%= f.label :password, "パスワード" %><%= f.password_field :password %></div>
  <div><%= f.label :password_confirmation, "確認" %><%= f.password_field :password_confirmation %></div>
  <%= f.submit "登録" %>
<% end %>
