<div class="page-header">
  <h1>資料</h1>
  <%= link_to "資料を追加", new_material_path, role: "button" %>
</div>

<% if params[:tag].present? %>
  <p>タグ <code>#<%= params[:tag] %></code> で絞り込み中 — <%= link_to "解除", materials_path %></p>
<% end %>

<%= form_with url: materials_path, method: :get, class: "per-form", data: { turbo_action: "advance" } do %>
  <% request.query_parameters.except("per", "page").each do |k, v| %>
    <%= hidden_field_tag k, v %>
  <% end %>
  表示件数:
  <%= select_tag :per, options_for_select([25, 50, 100], (params[:per].presence || 25).to_i),
                 class: "per-select", onchange: "this.form.requestSubmit()" %>
<% end %>

<% if @materials.any? %>
<% if params[:tag].blank? %><%= render "library_summary" %><% end %>
<div class="table-scroll">
<table class="materials-table">
  <thead>
    <tr>
      <th><%= sortable("type", "種別") %></th>
      <th><%= sortable("name", "タイトル") %></th>
      <th><%= sortable("uploader", "By") %></th>
      <th><%= sortable("created_at", "投稿日時") %></th>
      <th><%= sortable("published", "発行日") %></th>
      <th>タグ</th>
      <th>文字起こし</th>
    </tr>
  </thead>
  <tbody>
    <% @materials.each do |m| %>
      <tr>
        <td><%= render MaterialThumbComponent.new(material: m) %></td>
        <td><%= link_to m.title, material_path(m) %><% if m.comments_count > 0 %> <span class="muted"><%= icon("message-circle") %><%= m.comments_count %></span><% end %></td>
        <td><%= avatar_link(m.user, size: 24) %></td>
        <td><%= m.created_at.to_fs(:jp) %></td>
        <td><% if m.published %><%= m.published.label %><% else %><span class="muted">—</span><% end %></td>
        <td><% m.tags.each do |t| %><%= link_to "##{t.name}", materials_path(tag: t.slug) %> <% end %></td>
        <td>
          <% if (st = transcription_status_label(m)) %>
            <%= st %>
          <% else %>
            <span class="muted">—</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
<% else %>
  <div class="empty-state">
    資料（PDF・画像・動画・音声・URL）をここに集めます。お手持ちの本やサイト、動画など、出典になりそうなものを「資料を追加」から登録しておくと、記事から引用できます。
    <div class="empty-state__cta"><%= link_to "資料を追加", new_material_path, role: "button", class: "btn-sm" %></div>
  </div>
<% end %>
