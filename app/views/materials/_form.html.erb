<%= form_with model: material do |f| %>
  <% if material.errors.any? %>
    <ul class="errors">
      <% material.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>

  <p><%= f.label :title, "タイトル（任意）" %><br><%= f.text_field :title %></p>
  <p><%= f.label :description, "説明（任意）" %><br><%= f.text_area :description %></p>

  <fieldset>
    <legend>ファイル または URL のどちらか一方</legend>
    <p><%= f.label :file, "ファイル" %><br><%= f.file_field :file %></p>
    <p><%= f.label :url, "URL（YouTube等）" %><br><%= f.url_field :url, value: material.url %></p>
  </fieldset>

  <p><%= f.label :tag_names, "タグ（カンマ区切り）" %><br>
     <%= f.text_field :tag_names, value: material.tags.map(&:name).join(", ") %></p>

  <fieldset>
    <legend>出典情報（任意・書けるところだけでOK）</legend>
    <p><%= f.label :author, "著者・発言者" %><br><%= f.text_field :author %></p>
    <p><%= f.label :source, "出典元（掲載誌・書籍・サイト名）" %><br><%= f.text_field :source %></p>
    <p>
      <%= f.label :published_year, "発行日" %><br>
      <span class="date-row">
        <%= f.number_field :published_year, value: fuzzy_part(material.published, :year), placeholder: "年" %>
        <%= f.number_field :published_month, in: 1..12, value: fuzzy_part(material.published, :month), placeholder: "月" %>
        <%= f.number_field :published_day, in: 1..31, value: fuzzy_part(material.published, :day), placeholder: "日" %>
      </span>
    </p>
    <p><%= f.label :retrieved_on, "取得日（Web資料）" %><br><%= f.date_field :retrieved_on %></p>
    <p>
      <%= f.label :confidence, "信頼度" %><br>
      <% if Current.user&.admin? %>
        <%= f.select :confidence, Material::CONFIDENCE_LEVELS.map { |slug, label| [label, slug] }, { selected: material.confidence || "unconfirmed" } %>
      <% else %>
        <%= render BadgeComponent.new(text: material.confidence_label, variant: :status) %>
        <small class="muted">（信頼度の変更は管理者のみ）</small>
      <% end %>
    </p>
    <p>
      <%= f.label :rights, "権利状態" %><br>
      <%= f.select :rights, Material::RIGHTS_STATUSES.map { |slug, label| [label, slug] }, { include_blank: "未設定" } %>
    </p>
  </fieldset>

  <%= f.hidden_field :article_id %>
  <%= f.submit %>
<% end %>
