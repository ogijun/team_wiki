<%= link_to "← 資料一覧", materials_path, class: "back-link" %>
<h1><%= @material.title %></h1>
<p class="page-meta">
  <%= render BadgeComponent.new(text: @material.confidence_label, variant: :status) %>
  <% if @material.rights %><%= render BadgeComponent.new(text: @material.rights_label) %><% end %>
  <span>by <%= link_to display_name(@material.user), @material.user %> ・ <%= @material.created_at.to_fs(:jp) %></span>
</p>
<div class="actions">
  <%= link_to "資料情報を編集", edit_material_path(@material), role: "button", class: "btn-sm secondary outline" %>
</div>

<%# 進行ストリップ: 状態の全体像と次の行動を1行で。済み=チェック / 未完=リンク %>
<ul class="progress-strip">
  <% material_progress_steps(@material).each do |step| %>
    <li class="strip-step <%= step[:done] ? "strip-step--done" : "strip-step--todo" %>">
      <% if step[:done] %>
        <%= icon("check") %> <%= step[:text] %>
      <% elsif step[:path].nil? %>
        <%= step[:text] %>
      <% else %>
        <%= link_to step[:text], step[:path] %>
      <% end %>
    </li>
  <% end %>
</ul>

<%# ── ① 資料本体（プレビュー・実体・説明）── %>
<section class="material-body">
  <% if @material.link? %>
    <% if (src = MaterialEmbed.embed_src(@material.url)) %>
      <div class="embed">
        <iframe src="<%= src %>" width="640" height="360" frameborder="0" allowfullscreen></iframe>
      </div>
    <% end %>
    <p><%= link_to @material.url, @material.url, target: "_blank", rel: "noopener" %></p>
  <% else %>
    <% if @material.thumbnailable_file? %>
      <%# サムネ/ファイル名クリックで原寸をオーバーレイ表示。DLは隣のアイコンから（PDF と同じ構成） %>
      <div data-controller="viewer">
        <a href="#" data-action="viewer#open"><%= image_tag @material.thumbnail(640), style: "max-width:100%" %></a>
        <dialog class="lightbox" data-viewer-target="dialog" data-action="click->viewer#backdropClose">
          <%= image_tag rails_blob_path(@material.file), loading: "lazy" %>
        </dialog>
        <p>
          <a href="#" data-action="viewer#open"><%= icon("image") %> <%= @material.file.filename %></a>
          <%= link_to rails_blob_path(@material.file), title: "ダウンロード", class: "muted" do %><%= icon("download") %><% end %>
        </p>
      </div>
    <% elsif @material.file.content_type == "application/pdf" %>
      <%# ファイル名クリックでオーバーレイのページビューア（PDF.js は初回オープン時に遅延ロード）。DLは隣のアイコンから %>
      <div data-controller="pdf" data-pdf-url-value="<%= pdf_material_path(@material) %>">
        <div class="placeholder">ファイル名をクリックするとページビューアで読めます（ページ単位で部分読み込み）</div>
        <dialog class="lightbox lightbox--pdf" data-pdf-target="dialog" data-action="click->pdf#backdropClose">
          <div class="pdf-viewer">
            <div class="pdf-viewer__bar">
              <button type="button" class="btn-sm secondary outline" data-action="pdf#prev">前のページ</button>
              <span class="pdf-viewer__page" data-pdf-target="page">…</span>
              <button type="button" class="btn-sm secondary outline" data-action="pdf#next">次のページ</button>
              <span class="pdf-viewer__zoom">
                <button type="button" class="btn-sm secondary outline" data-action="pdf#zoomOut" aria-label="縮小">−</button>
                <span class="pdf-viewer__pct" data-pdf-target="pct">…</span>
                <button type="button" class="btn-sm secondary outline" data-action="pdf#zoomIn" aria-label="拡大">＋</button>
                <button type="button" class="btn-sm secondary outline" data-action="pdf#actualSize">等倍</button>
                <button type="button" class="btn-sm secondary outline" data-action="pdf#fit">フィット</button>
              </span>
              <button type="button" class="btn-sm secondary outline pdf-viewer__close" data-action="pdf#close" aria-label="閉じる">×</button>
            </div>
            <div class="pdf-viewer__stage" data-pdf-target="stage">
              <canvas data-pdf-target="canvas"></canvas>
            </div>
            <p class="muted" data-pdf-target="status"></p>
          </div>
        </dialog>
        <p>
          <a href="#" data-action="pdf#open"><%= icon("file-text") %> <%= @material.file.filename %></a>
          <%= link_to rails_blob_path(@material.file), title: "ダウンロード", class: "muted" do %><%= icon("download") %><% end %>
        </p>
      </div>
    <% else %>
      <div class="placeholder">プレビューは準備中です（この形式のプレビュー表示は今後対応）</div>
      <p><%= link_to rails_blob_path(@material.file) do %><%= icon("download") %> <%= @material.file.filename %><% end %></p>
    <% end %>
  <% end %>
  <% if @material.description.present? %>
    <%= simple_format @material.description %>
  <% end %>
</section>

<%# ── ② 書誌情報（空ならゾーンごと出さない。状態はストリップが担う）── %>
<% tags = @material.tags.to_a %>
<% if @material.bibliography_present? || @material.file_created_at || tags.any? %>
<section class="bibliography-section">
  <h2>書誌情報</h2>
    <dl class="bibliography">
      <% if @material.author.present? %><dt>著者・発言者</dt><dd><%= @material.author %></dd><% end %>
      <% if @material.source.present? %><dt>出典元</dt><dd><%= @material.source %></dd><% end %>
      <% if @material.volume %><dt>巻号</dt><dd><%= @material.volume %></dd><% end %>
      <% if @material.publisher %><dt>出版社・発行元</dt><dd><%= @material.publisher %></dd><% end %>
      <% if @material.published %><dt>発行日</dt><dd><%= @material.published.label %></dd><% end %>
      <% if @material.pages %><dt>ページ</dt><dd><%= @material.pages %></dd><% end %>
      <% if @material.page_count %><dt>総ページ数</dt><dd><%= number_with_delimiter(@material.page_count) %></dd><% end %>
      <% if @material.isbn %><dt>ISBN</dt><dd><%= @material.isbn %></dd><% end %>
      <% if @material.file_created_at %><dt>ファイル作成日</dt><dd><%= @material.file_created_at.to_fs(:jp) %> <small class="muted">（EXIF/PDF から自動抽出。発行日とは別）</small></dd><% end %>
      <% if tags.any? %>
        <dt>タグ</dt>
        <dd><% tags.each do |t| %><%= link_to "##{t.name}", materials_path(tag: t.slug) %> <% end %></dd>
      <% end %>
    </dl>
</section>
<% end %>

<%= render "shared/tag_suggestions", taggable: @material %>

<%# ── ③ 記事で使う（引用・被引用・文字起こし）── %>
<section class="usage" id="usage">
  <h2>記事で使う</h2>
  <p class="cite-row" data-controller="clipboard" data-clipboard-text-value="[[ref:<%= @material.slug %>]]">
    引用タグ <code>[[ref:<%= @material.slug %>]]</code>
    <%= button_tag "引用タグをコピー", type: "button", class: "btn-sm secondary outline", data: { action: "clipboard#copy" } %>
  </p>
  <small class="muted">記事本文に貼ると、この資料が出典として脚注に表示されます。</small>

  <% citing = @material.citing_articles.order(:title).to_a %>
  <% if citing.any? %>
    <h3>この資料を引用している記事</h3>
    <ul>
      <% citing.each do |a| %>
        <li><%= link_to a.title, a %></li>
      <% end %>
    </ul>
  <% end %>

  <% if @material.transcribable? && @material.transcription.nil? %>
    <h3>文字起こし</h3>
    <p class="muted">このメディアはまだ文字起こしされていません。聞き取れた／読み取れた範囲でOKです。</p>
    <%= link_to "文字起こしを作成", edit_material_transcription_path(@material), role: "button", class: "btn-sm" %>
  <% end %>
  <% if @material.transcribable? && (t = @material.transcription) %>
    <h3>文字起こし
      <%= render BadgeComponent.new(text: t.status_label, variant: :status) %>
    </h3>
    <% if t.creation_summary %>
      <p class="meta">作成: <%= t.creation_summary %></p>
    <% end %>
    <div class="prewrap"><%= t.preview_body %></div>
    <% if t.long? %>
      <p><%= link_to "続きを読む（あと#{number_with_delimiter(t.overflow_chars)}文字）", material_transcription_path(@material) %></p>
    <% end %>
    <p><%= link_to "文字起こしを編集", edit_material_transcription_path(@material), role: "button", class: "btn-sm secondary outline" %></p>
  <% end %>
</section>

<%# ── ④ 議論 ── %>
<%= render "comments/comments", commentable: @material %>

<div class="danger-zone">
  <span class="danger-zone__label">危険な操作</span>
  <%= button_to "削除", @material, method: :delete, class: "btn-sm btn-danger", data: { turbo_confirm: "削除しますか?" } %>
</div>
