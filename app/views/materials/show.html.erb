<%= link_to "← 資料一覧", materials_path, class: "back-link" %>
<h1><%= @material.title %></h1>
<p class="muted" data-controller="clipboard" data-clipboard-text-value="[[ref:<%= @material.slug %>]]">
  引用ハンドル: <code>[[ref:<%= @material.slug %>]]</code>
  <%= button_tag "引用タグをコピー", type: "button", class: "secondary outline btn-sm", data: { action: "clipboard#copy" } %>
</p>
<small class="muted">この <code>[[ref:…]]</code> を記事本文に貼ると、この資料を出典として脚注に表示できます。</small>
<p class="muted">by <%= display_name(@material.user) %> / <%= @material.created_at.to_fs(:jp) %>
  <% if @material.article %> — <%= link_to "📚#{@material.article.title}", @material.article %><% end %>
</p>
<p class="badges">
  <%= render BadgeComponent.new(text: @material.confidence_label, variant: :status) %>
  <% if @material.rights %><%= render BadgeComponent.new(text: @material.rights_label) %><% end %>
</p>
<div class="actions">
  <%= link_to "編集", edit_material_path(@material), role: "button", class: "btn-sm" %>
</div>

<div class="placeholder">ここには資料のサムネイルなどが表示される予定です（開発中）</div>

<% if @material.author.present? || @material.source.present? || @material.published %>
  <dl class="bibliography">
    <% if @material.author.present? %><dt>著者・発言者</dt><dd><%= @material.author %></dd><% end %>
    <% if @material.source.present? %><dt>出典元</dt><dd><%= @material.source %></dd><% end %>
    <% if @material.published %><dt>発行日</dt><dd><%= @material.published.label %></dd><% end %>
  </dl>
<% end %>

<% if @material.description.present? %>
  <p><%= simple_format @material.description %></p>
<% end %>

<% if @material.memo.present? %>
  <section class="memo">
    <h2>メモ</h2>
    <%= simple_format @material.memo %>
  </section>
<% end %>

<% if @material.transcribable? %>
  <section class="transcription">
    <h2>トランスクリプト
      <% if @material.transcription %>
        <%= render BadgeComponent.new(text: @material.transcription.status_label, variant: :status) %>
      <% end %>
    </h2>
    <% if @material.transcription %>
      <div class="prewrap"><%= @material.transcription.body %></div>
      <p><%= link_to "編集", edit_material_transcription_path(@material), role: "button", class: "btn-sm secondary outline" %></p>
    <% else %>
      <p class="muted">まだトランスクリプトがありません。</p>
      <%= link_to "作成", edit_material_transcription_path(@material), role: "button", class: "btn-sm" %>
    <% end %>
  </section>
<% end %>

<% if @material.link? %>
  <% if (src = MaterialEmbed.embed_src(@material.url)) %>
    <div class="embed">
      <iframe src="<%= src %>" width="640" height="360" frameborder="0" allowfullscreen></iframe>
    </div>
  <% end %>
  <p><%= link_to @material.url, @material.url, target: "_blank", rel: "noopener" %></p>
<% else %>
  <p><%= link_to "⬇ #{@material.file.filename}", rails_blob_path(@material.file) %></p>
  <% if @material.thumbnailable_file? %>
    <%= link_to image_tag(@material.thumbnail(640), style: "max-width:100%"), rails_blob_path(@material.file) %>
  <% end %>
<% end %>

<% tags = @material.tags.to_a %>
<% if tags.any? %>
  <p>タグ: <% tags.each do |t| %><%= link_to "##{t.name}", materials_path(tag: t.slug) %> <% end %></p>
<% end %>

<div class="danger-zone">
  <span class="danger-zone__label">危険な操作</span>
  <%= button_to "削除", @material, method: :delete, class: "btn-sm btn-danger", data: { turbo_confirm: "削除しますか?" } %>
</div>
