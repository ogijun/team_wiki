<%# locals: f:, attribute:, value:, label:, hint: %>
<div class="field fuzzy-date" data-controller="fuzzy-date" data-fuzzy-date-url-value="<%= fuzzy_date_path %>">
  <%= f.label attribute, label %><%= optional_badge %>
  <small class="field__hint"><%= hint %></small>
  <%= f.text_field attribute, value: FuzzyTimestamp.input_value(value), placeholder: "1979 / 1979/4 / 1979/4/7 14:30", autocomplete: "off",
        data: { fuzzy_date_target: "input", action: "input->fuzzy-date#preview" } %>
  <output data-fuzzy-date-target="preview"></output>
</div>
