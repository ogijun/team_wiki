<%# locals: f:, accessor:, fuzzy:, label:, hint: %>
<div class="field" data-controller="disclosure" data-disclosure-auto-reveal-if-set-value="true">
  <%= f.label "#{accessor}_year", label %><%= optional_badge %>
  <small class="field__hint"><%= hint %></small>
  <span class="date-row">
    <%= f.number_field "#{accessor}_year", value: fuzzy_part(fuzzy, :year), placeholder: "年" %>
    <%= f.number_field "#{accessor}_month", in: 1..12, value: fuzzy_part(fuzzy, :month), placeholder: "月" %>
    <%= f.number_field "#{accessor}_day", in: 1..31, value: fuzzy_part(fuzzy, :day), placeholder: "日" %>
    <button type="button" class="btn-inline-add" data-disclosure-target="toggle" data-action="disclosure#toggle" title="時刻を追加">＋時刻</button>
    <span class="date-row__time" data-disclosure-target="rest" hidden>
      <%= f.number_field "#{accessor}_hour", in: 0..23, value: fuzzy_part(fuzzy, :hour), placeholder: "時" %>:<%= f.number_field "#{accessor}_minute", in: 0..59, value: fuzzy_part(fuzzy, :minute), placeholder: "分" %>
    </span>
  </span>
</div>
