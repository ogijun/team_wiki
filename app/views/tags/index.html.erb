<h1>タグ一覧</h1>

<%= form_with model: @tag, url: tags_path do |f| %>
  <%= render "shared/error_messages", record: @tag %>
  <%= f.text_field :name, placeholder: "新しいタグ名" %>
  <%= f.submit "作成" %>
<% end %>

<ul>
  <% @tags.each do |t| %>
    <li>
      <%= link_to "##{t.name}", tag_path(t) %>
      <% if t.usage_count.zero? %>
        <%= button_to "削除", tag_path(t), method: :delete, class: "secondary outline btn-sm", data: { turbo_confirm: "タグ「#{t.name}」を削除しますか？" } %>
      <% end %>
    </li>
  <% end %>
</ul>
