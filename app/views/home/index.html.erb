<section class="home-hero">
  <h1 class="home-hero__brand"><%= brand_display %></h1>
  <% if site_setting.tagline.present? %>
    <p class="home-hero__tagline"><%= site_setting.tagline %></p>
  <% end %>

  <div class="home-hero__cta">
    <%= link_to new_article_path, class: "btn-hero" do %><%= icon("pencil-line") %> 記事を書く<% end %>
    <%= link_to new_material_path, class: "btn-hero btn-hero--ghost" do %><%= icon("library-big") %> 資料を追加<% end %>
    <span class="home-hero__cta-or">どちらもなければ</span>
    <%= link_to transcriptions_path, class: "btn-hero btn-hero--ghost" do %><%= icon("pen-line") %> 文字起こしをする<% end %>
  </div>

  <div class="home-hero__sum">
    <span><%= icon("pencil-line") %> <strong><%= @stats[:articles_count] %></strong> 記事</span>
    <span><%= icon("library-big") %> <strong><%= @stats[:materials_count] %></strong> 資料</span>
    <span><%= icon("search") %> <strong><%= @stats[:unconfirmed_materials_count] %></strong> 未確認資料</span>
    <span><%= icon("pen-line") %> <strong><%= number_with_delimiter(@stats[:transcribed_chars]) %></strong> 文字起こし済</span>
    <span><%= icon_link "trending-up", stats_path, label: "統計の推移" %></span>
  </div>
</section>

<% if @my_stats[:active_days].positive? %>
  <p class="my-streak muted">
    <%= avatar_tag(Current.user, size: 18) %> あなた:
    <% if @my_stats[:current_streak].positive? %><%= icon("flame") %> <strong><%= @my_stats[:current_streak] %></strong>日連続活動中 ・<% end %>
    最長 <strong><%= @my_stats[:longest_streak] %></strong>日 ・ 累計 <strong><%= @my_stats[:active_days] %></strong>日活動
  </p>
<% end %>

<div class="dashboard-grid">
  <section class="dashboard-card">
    <h2><%= icon("newspaper") %> 最近更新された記事</h2>
    <% if @recent_articles.any? %>
      <ul>
        <% @recent_articles.each do |article| %>
          <li>
            <%= link_to article.title, article %>
            <small><%= local_time_ago(article.updated_at) %></small>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">まだ記事がありません。「新規作成」から最初の1本をどうぞ。完璧でなくて大丈夫です。</p>
    <% end %>
    <p><%= link_to "記事一覧へ", articles_path %></p>
  </section>

  <section class="dashboard-card">
    <h2><%= icon("pencil-line") %> 加筆を求む</h2>
    <% if @stub_articles.any? %>
      <ul>
        <% @stub_articles.each do |article| %>
          <li>
            <%= link_to article.title, article %>
            <small><%= article.status_label %></small>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">スタブ/執筆中の記事はありません。</p>
    <% end %>
  </section>
</div>

<section class="dashboard-card recent-activity">
  <h2><%= icon("activity") %> 最近の動き</h2>
  <%# 連続同一ユーザを畳んでから 10 行に頭打ち（cap 後に畳むと行数が減るため、ホームのみ） %>
  <%= render "activities/timeline", groups: collapse_consecutive_actors(@recent_activity_groups).first(10) %>
  <p><%= link_to "すべて見る", activities_path %></p>
</section>

<section class="activity-block">
  <h2><%= icon("activity") %> サイトの動き</h2>
  <%= render "shared/activity_overview", daily: @daily[:total], hourly: @hourly[:total] %>
  <p><%= link_to "統計をくわしく見る", stats_path %></p>
</section>

