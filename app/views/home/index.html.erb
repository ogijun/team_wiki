<section class="home-hero">
  <%# 見出しは設定(home_heading)から注入。未設定はブランド名を繰り返さず sr-only 見出し。 %>
  <% if site_setting.home_heading.present? %>
    <h1 class="home-hero__heading"><%= site_setting.home_heading %></h1>
  <% else %>
    <h1 class="sr-only">ホーム</h1>
  <% end %>
  <% if site_setting.tagline.present? %>
    <p class="home-hero__tagline"><%= site_setting.tagline %></p>
  <% end %>

  <%# 資料主役の CTA（記事を書くは外す＝記事は降格） %>
  <div class="home-hero__cta">
    <%= link_to new_material_path, class: "btn-hero" do %><%= icon("library-big") %> 資料を追加する<% end %>
    <%= link_to transcriptions_path, class: "btn-hero" do %><%= icon("pen-line") %> 文字起こしをする<% end %>
  </div>

  <div class="home-hero__sum">
    <span><%= icon("library-big") %> <strong><%= @stats[:materials_count] %></strong> 資料</span>
    <span><%= icon("pen-line") %> <strong><%= number_with_delimiter(@stats[:transcribed_chars]) %></strong> 文字起こし済</span>
    <span><%= icon("audio-lines") %> <strong><%= @incomplete_count %></strong> 未完成資料</span>
    <span><%= icon_link "trending-up", stats_path, label: "統計の推移" %></span>
  </div>
</section>

<%# 実績ストリップ（将来）はここに入る。今は非描画。 %>

<div class="dashboard-grid">
  <section class="dashboard-card">
    <h2><%= icon("activity") %> 報告します！</h2>
    <%# 連続同一ユーザを畳んでから 10 行に頭打ち（cap 後に畳むと行数が減るため、ホームのみ） %>
    <%= render "activities/timeline", groups: collapse_consecutive_actors(@recent_activity_groups).first(10) %>
    <p><%= link_to "すべての動きを見る", activities_path %></p>
  </section>

  <section class="dashboard-card">
    <h2><%= icon("audio-lines") %> この続き、誰かお願い！</h2>
    <% if @incomplete_materials.any? %>
      <p class="muted">文字起こしが必要な資料です。</p>
      <ul>
        <% @incomplete_materials.each do |m| %>
          <% done, total = m.transcription_progress %>
          <li>
            <%= link_to m.title, m %>
            <small><%= total.zero? ? "未着手" : "途中 (#{done}/#{total})" %></small>
          </li>
        <% end %>
      </ul>
      <p><%= link_to "すべての未完成資料を表示", transcriptions_path %></p>
    <% else %>
      <p class="muted">未完成の資料はありません。よく整っています。</p>
    <% end %>
  </section>
</div>

<section class="activity-block">
  <h2><%= icon("activity") %> サイトの動き</h2>
  <%= render "shared/activity_overview", daily: @daily[:total], hourly: @hourly[:total] %>
  <p><%= link_to "統計をくわしく見る", stats_path %></p>
</section>
