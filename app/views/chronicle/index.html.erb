<h1>年表</h1>

<% @articles.group_by { |a| a.starts_at.year }.each do |year, articles| %>
  <section class="chronicle-year">
    <h2><%= year %>年</h2>
    <ul>
      <% articles.each do |a| %>
        <li>
          <%= render FuzzyDateComponent.new(starts: a.starts, ends: a.ends) %>
          <%= link_to a.title, a %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
