<%# fetch のブロック形式で遅延評価（位置引数のデフォルトは liked: を渡しても評価されてしまい N+1 になる） %>
<% liked = local_assigns.fetch(:liked) { reactable.liked_by?(Current.user) } %>
<div id="<%= dom_id(reactable, :like) %>" class="like-toggle">
  <%= button_to like_path, params: { reactable_type: reactable.class.name, reactable_id: reactable.id }, class: "btn-sm#{' secondary' unless liked}", aria: { label: "いいね" } do %>
    <%= icon("heart") %> <%= reactable.likes_count %>
  <% end %>
</div>
