<% content_for :title, "文字起こし進捗" %>
<div class="page-header"><h1>文字起こし進捗</h1></div>
<p class="page-lead">資料の文字起こしの進み具合。未着手のものから気軽に拾っていけます。</p>

<% if @groups.empty? %>
  <div class="empty-state">
    動画・音声・画像・PDF の資料を登録すると、ここに文字起こしの作業リストが並びます。聞き取れた／読み取れた範囲でOK、完璧でなくて大丈夫です。
    <div class="empty-state__cta"><%= link_to "資料を追加", new_material_path, role: "button", class: "btn-sm" %></div>
  </div>
<% else %>
<%# 状態タブ（クライアント側で panel を切り替え）。JS無効時は全パネルが見えるだけで機能は損なわない %>
<div data-controller="tabs">
  <nav class="tabs" role="tablist">
    <% [["todo", "未着手"], ["drafting", "作業中"], ["done", "完了"]].each do |key, label| %>
      <button type="button" class="tab" role="tab" data-tabs-target="tab" data-key="<%= key %>" data-action="tabs#select">
        <%= label %> <span class="pill"><%= (@groups[key] || []).size %></span>
      </button>
    <% end %>
  </nav>

  <% [["todo", "未着手"], ["drafting", "作業中"], ["done", "完了"]].each do |key, label| %>
    <% items = @groups[key] || [] %>
    <section class="tab-panel" role="tabpanel" data-tabs-target="panel" data-key="<%= key %>" aria-label="<%= label %>">
      <% if items.any? %>
        <ul class="rows">
          <% items.each do |m| %>
            <li class="row">
              <% done, total = m.transcription_progress %>
              <span class="row__main"><%= media_icon(m) %> <%= link_to m.title, m %></span>
              <% if total.positive? %><span class="meta"><span class="pill"><%= done %> / <%= total %></span></span><% end %>
              <%= link_to (key == "todo" ? "作成" : "編集"), m, class: "btn-sm" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">なし</p>
      <% end %>
    </section>
  <% end %>
</div>
<% end %>
