<div class="page-header"><h1>サイト設定</h1></div>
<% if notice %><p class="notice"><%= notice %></p><% end %>

<%= form_with model: @setting, url: settings_path, method: :patch do |f| %>
  <%= render "shared/error_messages", record: @setting %>

  <p>
    <%= f.label :brand_name, "ブランド名（ロゴ未設定時に表示）" %><br>
    <%= f.text_field :brand_name, placeholder: "Team Wiki" %>
  </p>

  <p>
    <%= f.label :logo, "ロゴ画像（任意・あれば名称より優先）" %><br>
    <% if @setting.logo.attached? %>
      <%= image_tag @setting.logo, class: "brand-logo" %>
      <label><%= check_box_tag :remove_logo, "1" %> ロゴを削除してテキスト名に戻す</label><br>
    <% end %>
    <%= f.file_field :logo, accept: "image/*" %>
  </p>

  <%= f.submit "更新" %>
<% end %>
