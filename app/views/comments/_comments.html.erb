<section class="comments">
  <h2>コメント<% if commentable.comments_count > 0 %> <span class="muted">(<%= commentable.comments_count %>)</span><% end %></h2>

  <% comments = commentable.comments.includes(author: { avatar_attachment: :blob }).order(:created_at) %>
  <% liked_keys = liked_reactable_keys(comments) %>
  <% if comments.any? %>
    <ul class="comment-list">
      <% comments.each do |c| %>
        <li class="comment">
          <div class="comment__head">
            <%= avatar_link(c.author, size: 24) %>
            <%= link_to display_name(c.author), c.author, class: "comment__author" %>
            <span class="muted"><%= local_time_ago(c.created_at) %></span>
            <%= render "likes/button", reactable: c, liked: liked_keys.include?([ "Comment", c.id ]) %>
            <% if c.deletable_by?(Current.user) %>
              <%= button_to "削除", comment_path(c), method: :delete, class: "btn-sm btn-danger comment__delete", form_class: "comment__delete-form", data: { turbo_confirm: "このコメントを削除しますか?" } %>
            <% end %>
          </div>
          <div class="prewrap comment__body"><%= render_comment_body(c.body, mention_members) %></div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="muted">まだコメントはありません。</div>
  <% end %>

  <% members_json = mention_members.map { |member| { id: member.id, name: display_name(member) } }.to_json %>
  <%= form_with model: [ commentable, Comment.new ], class: "comment-form mention-picker",
        data: { controller: "mention", "mention-members-value": members_json } do |f| %>
    <%= f.text_area :body, rows: 3, placeholder: "コメントを書く…",
          data: { "mention-target": "input", action: "input->mention#search keydown->mention#keydown" } %>
    <div class="mention-picker__menu" data-mention-target="menu" hidden></div>
    <%= f.submit "コメントする", class: "btn-sm" %>
  <% end %>
</section>
