<h1>メンバー</h1>
<p class="page-lead">このサイトのメンバー <%= @users.size %> 人。</p>
<table>
  <thead><tr><th></th><th>名前</th><th>ロール</th><th>初回ログイン</th><th>最終ログイン</th><th>最終アクセス</th><th>最新活動</th></tr></thead>
  <tbody>
    <% @users.each do |u| %>
      <tr>
        <td><%= avatar_tag(u, size: 28) %></td>
        <td><%= link_to display_name(u), u %></td>
        <td><% if u.admin? %><%= render BadgeComponent.new(text: "管理者", variant: :status) %><% else %>編集<% end %></td>
        <td><small><%= u.created_at.to_fs(:simple) %></small></td>
        <td><small><%= @last_login[u.id]&.to_fs(:simple) || "—" %></small></td>
        <td><small><%= u.last_seen_at&.to_fs(:simple) || "—" %></small></td>
        <td><small><%= @last_activity[u.id]&.to_fs(:simple) || "—" %></small></td>
      </tr>
    <% end %>
  </tbody>
</table>
