<h1>メンバー</h1>
<table>
  <thead><tr><th></th><th>名前</th><th>ロール</th><th>参加日</th><th>最終活動</th></tr></thead>
  <tbody>
    <% @users.each do |u| %>
      <tr>
        <td><%= avatar_tag(u, size: 28) %></td>
        <td><%= link_to display_name(u), u %></td>
        <td><% if u.admin? %><%= render BadgeComponent.new(text: "管理者", variant: :status) %><% else %>編集<% end %></td>
        <td><%= u.created_at.to_date %></td>
        <td><%= @last_activity[u.id]&.to_date %></td>
      </tr>
    <% end %>
  </tbody>
</table>
