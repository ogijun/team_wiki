# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Example of extracting secrets from 1password (or another compatible pw manager)
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})

# Example of extracting secrets from Rails credentials
# KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)

# Use a GITHUB_TOKEN if private repositories are needed for the image
# GITHUB_TOKEN=$(gh config get -h github.com oauth_token)

# Grab the registry password from ENV
# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(cat config/master.key)

# Docker Hub registry password: reuse the same access token as reserve_app
# (co-hosted on this VPS, same ogijun account).
REGISTRY_SECRETS=$(kamal secrets fetch --adapter 1password --account ogijun.1password.com --from Private/reserve_app_deploy_secrets KAMAL_REGISTRY_PASSWORD)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${REGISTRY_SECRETS})

# Discord OAuth + role mapping (production). Populate this 1Password item with fields
# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_GUILD_ID, DISCORD_REQUIRED_ROLE_ID,
# DISCORD_ADMIN_ROLE_ID (same Discord app/guild as dev). Adjust --account/--from to match.
DISCORD_SECRETS=$(kamal secrets fetch --adapter 1password --account ogijun.1password.com --from Private/team-wiki-deploy DISCORD_CLIENT_ID DISCORD_CLIENT_SECRET DISCORD_GUILD_ID DISCORD_REQUIRED_ROLE_ID DISCORD_ADMIN_ROLE_ID)
DISCORD_CLIENT_ID=$(kamal secrets extract DISCORD_CLIENT_ID ${DISCORD_SECRETS})
DISCORD_CLIENT_SECRET=$(kamal secrets extract DISCORD_CLIENT_SECRET ${DISCORD_SECRETS})
DISCORD_GUILD_ID=$(kamal secrets extract DISCORD_GUILD_ID ${DISCORD_SECRETS})
DISCORD_REQUIRED_ROLE_ID=$(kamal secrets extract DISCORD_REQUIRED_ROLE_ID ${DISCORD_SECRETS})
DISCORD_ADMIN_ROLE_ID=$(kamal secrets extract DISCORD_ADMIN_ROLE_ID ${DISCORD_SECRETS})

