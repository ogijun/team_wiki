# Template for .kamal/secrets — copy to ".kamal/secrets" (gitignored) and fill in
# your own password-manager account/items.
#
# Secrets referenced here are available under registry/password, env/secret,
# builder/secrets, and accessories/*/env/secret in config/deploy.yml. All secrets
# should be pulled from a password manager, ENV, or a file.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
# See https://kamal-deploy.org/docs/commands/secrets/

# Rails master key (never check config/master.key into git).
RAILS_MASTER_KEY=$(cat config/master.key)

# Docker registry password — pull from your password manager.
REGISTRY_SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/your-deploy-item KAMAL_REGISTRY_PASSWORD)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${REGISTRY_SECRETS})

# Discord OAuth + role mapping (production). The item must expose:
# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_GUILD_ID, DISCORD_REQUIRED_ROLE_ID, DISCORD_ADMIN_ROLE_ID
DISCORD_SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/your-deploy-item DISCORD_CLIENT_ID DISCORD_CLIENT_SECRET DISCORD_GUILD_ID DISCORD_REQUIRED_ROLE_ID DISCORD_ADMIN_ROLE_ID)
DISCORD_CLIENT_ID=$(kamal secrets extract DISCORD_CLIENT_ID ${DISCORD_SECRETS})
DISCORD_CLIENT_SECRET=$(kamal secrets extract DISCORD_CLIENT_SECRET ${DISCORD_SECRETS})
DISCORD_GUILD_ID=$(kamal secrets extract DISCORD_GUILD_ID ${DISCORD_SECRETS})
DISCORD_REQUIRED_ROLE_ID=$(kamal secrets extract DISCORD_REQUIRED_ROLE_ID ${DISCORD_SECRETS})
DISCORD_ADMIN_ROLE_ID=$(kamal secrets extract DISCORD_ADMIN_ROLE_ID ${DISCORD_SECRETS})

# Object-storage credentials — only needed when switching Active Storage to R2/S3
# (also set ACTIVE_STORAGE_SERVICE and the env.secret list in config/deploy.yml).
# R2_SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/your-r2-item R2_ENDPOINT R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY)
# R2_ENDPOINT=$(kamal secrets extract R2_ENDPOINT ${R2_SECRETS})
# R2_ACCESS_KEY_ID=$(kamal secrets extract R2_ACCESS_KEY_ID ${R2_SECRETS})
# R2_SECRET_ACCESS_KEY=$(kamal secrets extract R2_SECRET_ACCESS_KEY ${R2_SECRETS})

# litestream（SQLite → R2 ストリーミングバックアップ）。BUCKET が注入された時だけ複製が起動する。
# 値を入れたら config/deploy.yml の env.secret 側もコメントアウトを外すこと。item は次を持つ:
# LITESTREAM_REPLICA_BUCKET, LITESTREAM_REPLICA_ENDPOINT, LITESTREAM_REPLICA_REGION, LITESTREAM_ACCESS_KEY_ID, LITESTREAM_SECRET_ACCESS_KEY
# LITESTREAM_SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/your-r2-item LITESTREAM_REPLICA_BUCKET LITESTREAM_REPLICA_ENDPOINT LITESTREAM_REPLICA_REGION LITESTREAM_ACCESS_KEY_ID LITESTREAM_SECRET_ACCESS_KEY)
# LITESTREAM_REPLICA_BUCKET=$(kamal secrets extract LITESTREAM_REPLICA_BUCKET ${LITESTREAM_SECRETS})
# LITESTREAM_REPLICA_ENDPOINT=$(kamal secrets extract LITESTREAM_REPLICA_ENDPOINT ${LITESTREAM_SECRETS})
# LITESTREAM_REPLICA_REGION=$(kamal secrets extract LITESTREAM_REPLICA_REGION ${LITESTREAM_SECRETS})
# LITESTREAM_ACCESS_KEY_ID=$(kamal secrets extract LITESTREAM_ACCESS_KEY_ID ${LITESTREAM_SECRETS})
# LITESTREAM_SECRET_ACCESS_KEY=$(kamal secrets extract LITESTREAM_SECRET_ACCESS_KEY ${LITESTREAM_SECRETS})
